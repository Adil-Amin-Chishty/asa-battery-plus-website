# Run npm run admin:setup to generate local admin credentials interactively.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Required on hosted deployments; use the exact HTTPS origin, without trailing slash.
APP_ORIGIN=http://localhost:3000
# Hosted libSQL database (Turso). Leave blank for local development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local development only. Photos and catalog are stored together in this database.
CATALOG_DB_PATH=storage/catalog.sqlite
